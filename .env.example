# Copy to `.env` and adjust. `.env` is git-ignored - never commit real secrets.
#
# SECURITY NOTE: a previous revision of this repo committed a live NVIDIA API
# key in `.env`. That key must be rotated/revoked in the provider console. This
# architecture does not use a public LLM for production data - production runs
# a self-hosted vLLM model (see docker-compose.prod.yml).

# ---------------------------------------------------------------------------
# Shared
# ---------------------------------------------------------------------------
APP_ENVIRONMENT=local          # local | staging | production | test
APP_LOG_LEVEL=INFO
APP_LOG_JSON=true              # false for human-readable local logs

# ---------------------------------------------------------------------------
# app service
# ---------------------------------------------------------------------------
APP_HOST=0.0.0.0
APP_PORT=8000

# Comma-separated browser origins, or * (dev only). REQUIRED in production.
APP_CORS_ALLOW_ORIGINS=*

# Database. Local default is a SQLite file (no infra). Production: Postgres.
APP_DATABASE_URL=sqlite+pysqlite:///./data/app.db
# APP_DATABASE_URL=postgresql+psycopg://dd:dd@localhost:5432/duediligence
APP_DB_POOL_SIZE=10
APP_DB_MAX_OVERFLOW=20

# LLM client.
#   echo          - deterministic stub, no network (local dev / CI)
#   openai_compat - self-hosted vLLM, NVIDIA NIM, OpenAI, TGI (production)
APP_LLM_PROVIDER=echo
APP_LLM_BASE_URL=http://localhost:8001/v1
APP_LLM_API_KEY=not-needed-for-self-hosted
APP_LLM_MODEL=meta-llama/Llama-3.1-8B-Instruct
APP_LLM_TEMPERATURE=0.4
APP_LLM_REQUEST_TIMEOUT_SECONDS=180
APP_LLM_MAX_RETRIES=2
APP_LLM_MAX_TOKENS=1024
APP_LLM_REPORT_MAX_TOKENS=4096
APP_LLM_MAX_REPAIR_ATTEMPTS=2

# RAG client.
#   http        - call the standalone rag service (production)
#   in_process  - run retrieval in the app process (single node)
APP_RAG_MODE=in_process
APP_RAG_BASE_URL=http://localhost:8100
APP_RAG_REQUEST_TIMEOUT_SECONDS=20
APP_RAG_RETRIEVAL_TOP_K=10
APP_RAG_FOLLOWUP_TOP_K=4
APP_RAG_COLLECTION=due_diligence_knowledge

APP_NUM_QUESTIONS=10
APP_MAX_FOLLOWUPS_PER_QUESTION=3
APP_READINESS_CHECK_DEPENDENCIES=true

# ---------------------------------------------------------------------------
# rag service
# ---------------------------------------------------------------------------
RAG_HOST=0.0.0.0
RAG_PORT=8100
RAG_SOURCE_URL=https://www.startupscience.io/articles/startup-due-diligence-checklist
RAG_EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
RAG_CHROMA_MODE=embedded        # embedded | http
RAG_CHROMA_PERSIST_DIR=./data/chroma
RAG_CHROMA_HOST=localhost
RAG_CHROMA_PORT=8000
RAG_CHROMA_COLLECTION=due_diligence_knowledge
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150

# ---------------------------------------------------------------------------
# vLLM (production overlay only)
# ---------------------------------------------------------------------------
# VLLM_MODEL=meta-llama/Llama-3.1-8B-Instruct
# VLLM_MAX_MODEL_LEN=8192
# VLLM_GPU_COUNT=1
# HUGGING_FACE_HUB_TOKEN=

# ---------------------------------------------------------------------------
# Tests
# ---------------------------------------------------------------------------
# RUN_LIVE_TESTS=1   # opt in to tests that hit a real LLM endpoint
